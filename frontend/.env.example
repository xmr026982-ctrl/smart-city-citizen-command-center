# Copy this file to .env (same folder) and fill in your own values.
# .env and .env.local are never committed.

# Backend address, e.g. http://localhost:5000/api
# Signing in needs it: every account is checked by the server.
VITE_API_URL=

# Google sign-in for citizens (Firebase web settings).
# Leave empty to hide the Google button.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Map tiles and traffic. Restrict each key to your site's domain in its dashboard:
# anything starting with VITE_ is readable in the browser by design.
VITE_MAPTILER_KEY=
VITE_TOMTOM_API_KEY=

