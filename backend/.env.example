# Copy this file to .env (same folder) and fill in your own values.
# .env is never committed. Never paste real values into this file.

# ---- Core (required) ----
# MongoDB connection string (Atlas or local)
MONGO_URI=
# At least 32 random characters. The server refuses to start without it.
# Make one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=5000
NODE_ENV=development

# ---- Addresses ----
# The frontend address(es), comma-separated, no trailing slash. Used for CORS,
# Socket.io and the links in emails.
FRONTEND_URL=http://localhost:5173
# This API's public address (photo links are built from it).
API_PUBLIC_URL=http://localhost:5000

# ---- Sign-in cookie ----
# The session is an httpOnly cookie. Leave these empty for local work and
# for a frontend and API on the same site. Set COOKIE_SAMESITE=none only when
# they are on different sites (two different domains); that needs HTTPS.
COOKIE_SAMESITE=
COOKIE_SECURE=

# ---- Hosting ----
# Set to 1 when the API runs behind a hosting proxy (Render, Railway, Azure,
# Nginx) so rate limits see each visitor's real address. Leave empty locally.
TRUST_PROXY=

# ---- Email (setup links, password resets, contact form) ----
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Inbox that receives the contact form
SUPPORT_EMAIL=

# ---- City Health readings (server-side only; never sent to the browser) ----
# Air quality: CPCB via data.gov.in (free key)
CPCB_API_KEY=
CPCB_AQI_RESOURCE_ID=
# Traffic flow: TomTom
TOMTOM_API_KEY=
# Rainfall and heat come from Open-Meteo: free, no key.

# ---- Google sign-in for citizens (optional) ----
# Either put the Firebase service account file at config/serviceAccountKey.json
# (never committed) or paste its JSON on one line here.
# Without either, Google sign-in is off and everything else works.
FIREBASE_SERVICE_ACCOUNT=

# ---- One-time account seeding (scripts/seed.js) ----
# Run "npm run seed", then delete these lines. Wrap each value in double
# quotes: an unquoted # starts a comment and would cut the password short.
# SEED_1="admin|Full Name|email|password"
# SEED_2="staff|Full Name|email|password|Zone|expertise|Rank|Experience"
# SEED_3="citizen|Full Name|email|password|Zone"
